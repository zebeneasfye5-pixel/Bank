import React, { useState, useMemo, useEffect } from 'react';
import {
  Wallet,
  ArrowUpRight,
  ArrowDownLeft,
  ArrowLeftRight,
  PlusCircle,
  Eye,
  EyeOff,
  Search,
  ShieldCheck,
  Building2,
  CheckCircle2,
  FileText,
  DollarSign,
  PieChart,
  Lock,
  Smartphone,
  CreditCard,
  Printer,
  X,
  Share2,
  RefreshCw,
  TrendingUp,
  Upload,
  Sliders,
  Zap,
  Download,
  Globe,
  ExternalLink,
  Sparkles,
  AlertCircle,
  Copy,
  Check
} from 'lucide-react';
import { Account, BudgetCategory, Contact, Language, Transaction, TransactionType } from './types';
import { INITIAL_ACCOUNTS, INITIAL_BUDGETS, INITIAL_CONTACTS, INITIAL_TRANSACTIONS } from './data';

interface BeforeInstallPromptEvent extends Event {
  prompt: () => Promise<void>;
  userChoice: Promise<{ outcome: 'accepted' | 'dismissed' }>;
}

const LIVE_DEPLOYED_URL = 'https://ais-pre-wymcjnbltm7zo2x3a5rv4a-125744783365.europe-west1.run.app';

export default function App() {
  const [lang, setLang] = useState<Language>('am');
  const [showBalances, setShowBalances] = useState<boolean>(true);

  // Persistent Accounts in localStorage
  const [accounts, setAccounts] = useState<Account[]>(() => {
    try {
      const saved = localStorage.getItem('birrflow_accounts');
      return saved ? JSON.parse(saved) : INITIAL_ACCOUNTS;
    } catch {
      return INITIAL_ACCOUNTS;
    }
  });

  // Persistent Transactions in localStorage
  const [transactions, setTransactions] = useState<Transaction[]>(() => {
    try {
      const saved = localStorage.getItem('birrflow_transactions');
      return saved ? JSON.parse(saved) : INITIAL_TRANSACTIONS;
    } catch {
      return INITIAL_TRANSACTIONS;
    }
  });

  const [budgets] = useState<BudgetCategory[]>(INITIAL_BUDGETS);
  const [contacts] = useState<Contact[]>(INITIAL_CONTACTS);

  // Save to localStorage whenever accounts or transactions change
  useEffect(() => {
    try {
      localStorage.setItem('birrflow_accounts', JSON.stringify(accounts));
    } catch (e) {
      console.error(e);
    }
  }, [accounts]);

  useEffect(() => {
    try {
      localStorage.setItem('birrflow_transactions', JSON.stringify(transactions));
    } catch (e) {
      console.error(e);
    }
  }, [transactions]);

  // PWA Install Prompt State
  const [deferredPrompt, setDeferredPrompt] = useState<BeforeInstallPromptEvent | null>(null);
  const [isInstallModalOpen, setIsInstallModalOpen] = useState(false);
  const [isCopiedUrl, setIsCopiedUrl] = useState(false);

  useEffect(() => {
    const handleBeforeInstall = (e: Event) => {
      e.preventDefault();
      setDeferredPrompt(e as BeforeInstallPromptEvent);
    };

    window.addEventListener('beforeinstallprompt', handleBeforeInstall);

    return () => {
      window.removeEventListener('beforeinstallprompt', handleBeforeInstall);
    };
  }, []);

  const handleInstallClick = async () => {
    if (deferredPrompt) {
      try {
        await deferredPrompt.prompt();
        const choice = await deferredPrompt.userChoice;
        if (choice.outcome === 'accepted') {
          showToast(
            lang === 'am'
              ? 'መተግበሪያው በተሳካ ሁኔታ ስልክዎ/ኮምፒውተርዎ ላይ ተጭኗል!'
              : 'App successfully installed on your device!'
          );
        }
        setDeferredPrompt(null);
        return;
      } catch (err) {
        console.log(err);
      }
    }
    setIsInstallModalOpen(true);
  };

  const handleDownloadAppFile = () => {
    const htmlContent = `<!DOCTYPE html>
<html lang="am">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>BirrFlow - Dashen Bank Live App</title>
  <meta http-equiv="refresh" content="0; url=${LIVE_DEPLOYED_URL}">
  <style>
    body { font-family: system-ui, -apple-system, sans-serif; background: #020617; color: white; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; text-align: center; }
    .card { background: #0f172a; padding: 32px; border-radius: 24px; border: 1px solid #1e293b; max-width: 400px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5); }
    h2 { color: #f59e0b; margin-top: 0; }
    a { color: #020617; background: #f59e0b; font-weight: bold; font-size: 16px; text-decoration: none; padding: 14px 28px; border-radius: 12px; display: inline-block; margin-top: 20px; transition: background 0.2s; }
    a:hover { background: #d97706; }
  </style>
</head>
<body>
  <div class="card">
    <h2>BirrFlow Live App</h2>
    <p>የዳሽን ባንክ የቀጥታ ገንዘብ እና የፋይናንስ መቆጣጠሪያ መተግበሪያን በመክፈት ላይ...</p>
    <a href="${LIVE_DEPLOYED_URL}">መተግበሪያውን አሁን ክፈት (Open App)</a>
  </div>
  <script>
    window.location.replace("${LIVE_DEPLOYED_URL}");
  </script>
</body>
</html>`;

    const blob = new Blob([htmlContent], { type: 'text/html' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'BirrFlow_Bank_App.html';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    showToast(
      lang === 'am'
        ? 'የመተግበሪያው ፋይል (BirrFlow_Bank_App.html) ወርዷል!'
        : 'App launcher file downloaded successfully!'
    );
  };

  const handleCopyAppUrl = () => {
    navigator.clipboard.writeText(LIVE_DEPLOYED_URL);
    setIsCopiedUrl(true);
    showToast(lang === 'am' ? 'የመተግበሪያው የቀጥታ ሊንክ ኮፒ ተደርጓል!' : 'Direct App URL copied to clipboard!');
    setTimeout(() => setIsCopiedUrl(false), 3000);
  };

  // Live Sync & Simulation State
  const [lastSyncTime, setLastSyncTime] = useState<string>('አሁን (Just now)');
  const [isSyncing, setIsSyncing] = useState<boolean>(false);
  const [timeRange, setTimeRange] = useState<'all' | 'today' | 'week' | 'month'>('month');

  // Filter state
  const [activeTab, setActiveTab] = useState<'dashboard' | 'analytics' | 'transactions' | 'security'>('dashboard');
  const [filterType, setFilterType] = useState<string>('all');
  const [searchQuery, setSearchQuery] = useState<string>('');

  // Modals state
  const [isTransferModalOpen, setIsTransferModalOpen] = useState(false);
  const [isAddTxModalOpen, setIsAddTxModalOpen] = useState(false);
  const [isSetBalanceModalOpen, setIsSetBalanceModalOpen] = useState(false);
  const [isImportStatementModalOpen, setIsImportStatementModalOpen] = useState(false);
  const [selectedReceipt, setSelectedReceipt] = useState<Transaction | null>(null);
  const [toastMessage, setToastMessage] = useState<string | null>(null);

  // Balance Override Form
  const [targetAccountId, setTargetAccountId] = useState<string>(accounts[0]?.id || '');
  const [newBalanceInput, setNewBalanceInput] = useState<string>('');

  // Transfer Form State
  const [transferFrom, setTransferFrom] = useState<string>(accounts[0]?.id || '');
  const [transferBank, setTransferBank] = useState<string>('Dashen Bank');
  const [transferRecipientAcc, setTransferRecipientAcc] = useState<string>('');
  const [transferRecipientName, setTransferRecipientName] = useState<string>('');
  const [transferAmount, setTransferAmount] = useState<string>('');
  const [transferNote, setTransferNote] = useState<string>('');
  const [transferPin, setTransferPin] = useState<string>('');
  const [transferError, setTransferError] = useState<string>('');

  // Add Custom Transaction State
  const [newTxType, setNewTxType] = useState<TransactionType>('income');
  const [newTxAccount, setNewTxAccount] = useState<string>(accounts[0]?.id || '');
  const [newTxTitle, setNewTxTitle] = useState<string>('');
  const [newTxAmount, setNewTxAmount] = useState<string>('');
  const [newTxCategory, setNewTxCategory] = useState<string>('General');

  // Statement Import State
  const [statementText, setStatementText] = useState<string>('');

  const showToast = (msg: string) => {
    setToastMessage(msg);
    setTimeout(() => setToastMessage(null), 4000);
  };

  useEffect(() => {
    const updateTime = () => {
      const now = new Date();
      setLastSyncTime(
        `${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}:${now.getSeconds().toString().padStart(2, '0')}`
      );
    };

    updateTime();
    const interval = setInterval(updateTime, 10000);
    return () => clearInterval(interval);
  }, []);

  const handleManualSync = () => {
    setIsSyncing(true);
    setTimeout(() => {
      setIsSyncing(false);
      const now = new Date();
      setLastSyncTime(
        `${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}:${now.getSeconds().toString().padStart(2, '0')}`
      );
      showToast(
        lang === 'am'
          ? 'የዳሽን ባንክ እና የሁሉም ሂሳቦች እንቅስቃሴ በቀጥታ ተመሳስሏል!'
          : 'Live bank balances and transactions refreshed successfully!'
      );
    }, 600);
  };

  const totalBalance = useMemo(() => {
    return accounts.reduce((acc, curr) => acc + curr.balance, 0);
  }, [accounts]);

  const dashenAccount = useMemo(() => {
    return accounts.find((a) => a.id === 'acc-1') || accounts[0];
  }, [accounts]);

  const totalIncome = useMemo(() => {
    return transactions
      .filter((t) => t.type === 'income')
      .reduce((sum, t) => sum + t.amount, 0);
  }, [transactions]);

  const totalExpense = useMemo(() => {
    return transactions
      .filter((t) => t.type === 'expense' || t.type === 'bill')
      .reduce((sum, t) => sum + t.amount, 0);
  }, [transactions]);

  const netCashFlow = totalIncome - totalExpense;

  const filteredTransactions = useMemo(() => {
    return transactions.filter((tx) => {
      const matchesType = filterType === 'all' || tx.type === filterType;
      const title = lang === 'am' ? tx.titleAm : tx.title;
      const category = lang === 'am' ? tx.categoryAm : tx.category;
      const query = searchQuery.toLowerCase();
      const matchesSearch =
        title.toLowerCase().includes(query) ||
        category.toLowerCase().includes(query) ||
        tx.referenceNo.toLowerCase().includes(query) ||
        (tx.recipientName && tx.recipientName.toLowerCase().includes(query));
      return matchesType && matchesSearch;
    });
  }, [transactions, filterType, searchQuery, lang]);

  const formatMoney = (amount: number, currency: string = 'ETB') => {
    if (!showBalances) return '••••••';
    return `${amount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ${
      currency === 'ETB' ? (lang === 'am' ? 'ብር' : 'ETB') : currency
    }`;
  };

  const handleSelectContact = (contact: Contact) => {
    setTransferRecipientName(contact.name);
    setTransferRecipientAcc(contact.accountNumber);
    setTransferBank(contact.bank);
  };

  const handleUpdateDirectBalance = (e: React.FormEvent) => {
    e.preventDefault();
    const newBal = parseFloat(newBalanceInput);
    if (isNaN(newBal) || newBal < 0) {
      showToast(lang === 'am' ? 'እባክዎ ትክክለኛ የብር መጠን ያስገቡ' : 'Please enter valid balance amount');
      return;
    }

    const currentAcc = accounts.find((a) => a.id === targetAccountId);
    const oldBalance = currentAcc ? currentAcc.balance : 0;
    const diff = newBal - oldBalance;

    setAccounts((prev) =>
      prev.map((acc) => (acc.id === targetAccountId ? { ...acc, balance: newBal } : acc))
    );

    if (diff !== 0) {
      const ref = `REC-BAL-${Math.floor(100000 + Math.random() * 900000)}`;
      const reconTx: Transaction = {
        id: `tx-recon-${Date.now()}`,
        type: diff > 0 ? 'income' : 'expense',
        title: `Direct Balance Adjustment (${Math.abs(diff).toLocaleString()} ETB)`,
        titleAm: `የቀጥታ ሂሳብ ማስተካከያ (${Math.abs(diff).toLocaleString()} ብር)`,
        amount: Math.abs(diff),
        currency: 'ETB',
        date: new Date().toISOString().replace('T', ' ').slice(0, 16),
        category: 'Balance Reconciliation',
        categoryAm: 'የቀጥታ ሂሳብ ማስተካከያ',
        fromAccountId: targetAccountId,
        status: 'completed',
        referenceNo: ref,
        note: `Manual balance updated from ${oldBalance.toLocaleString()} to ${newBal.toLocaleString()} ETB`,
      };
      setTransactions((prev) => [reconTx, ...prev]);
    }

    setIsSetBalanceModalOpen(false);
    setNewBalanceInput('');
    showToast(
      lang === 'am'
        ? `የባንክ ሂሳቡ በቀጥታ ወደ ${newBal.toLocaleString()} ብር ተስተካክሏል!`
        : `Live balance successfully adjusted to ${newBal.toLocaleString()} ETB!`
    );
  };

  const handleExecuteTransfer = (e: React.FormEvent) => {
    e.preventDefault();
    setTransferError('');

    const amountNum = parseFloat(transferAmount);
    if (isNaN(amountNum) || amountNum <= 0) {
      setTransferError(lang === 'am' ? 'እባክዎ ትክክለኛ የገንዘብ መጠን ያስገቡ።' : 'Please enter a valid transfer amount.');
      return;
    }

    const sourceAccount = accounts.find((a) => a.id === transferFrom);
    if (!sourceAccount) {
      setTransferError(lang === 'am' ? 'እባክዎ መነሻ ሂሳብ ይምረጡ።' : 'Please select a source account.');
      return;
    }

    if (sourceAccount.balance < amountNum) {
      setTransferError(
        lang === 'am'
          ? `በቂ ቀሪ ሂሳብ የለም። አሁን ያለው፦ ${sourceAccount.balance.toLocaleString()} ብር`
          : `Insufficient funds. Current balance: ${sourceAccount.balance.toLocaleString()} ETB`
      );
      return;
    }

    if (!transferRecipientAcc.trim()) {
      setTransferError(lang === 'am' ? 'የተቀባይ አካውንት ቁጥር ያስገቡ።' : 'Enter recipient account number.');
      return;
    }

    if (transferPin.length < 4) {
      setTransferError(lang === 'am' ? 'እባክዎ 4 አሃዝ ሚስጥር ቁጥር (PIN) ያስገቡ።' : 'Please enter 4-digit security PIN.');
      return;
    }

    const ref = `TX-DSH-${Math.floor(100000 + Math.random() * 900000)}`;
    const newTx: Transaction = {
      id: `tx-${Date.now()}`,
      type: 'transfer',
      title: `Transfer to ${transferRecipientName || transferRecipientAcc}`,
      titleAm: `ወደ ${transferRecipientName || transferRecipientAcc} የተደረገ ዝውውር`,
      amount: amountNum,
      currency: sourceAccount.currency,
      date: new Date().toISOString().replace('T', ' ').slice(0, 16),
      category: 'Transfer',
      categoryAm: 'የገንዘብ ዝውውር',
      fromAccountId: sourceAccount.id,
      recipientName: transferRecipientName || 'Bank Account',
      recipientAccount: transferRecipientAcc,
      recipientBank: transferBank,
      status: 'completed',
      referenceNo: ref,
      note: transferNote || (lang === 'am' ? 'መደበኛ የባንክ ዝውውር' : 'Standard bank transfer'),
    };

    setAccounts((prev) =>
      prev.map((acc) => (acc.id === sourceAccount.id ? { ...acc, balance: acc.balance - amountNum } : acc))
    );
    setTransactions((prev) => [newTx, ...prev]);

    setIsTransferModalOpen(false);
    setTransferAmount('');
    setTransferRecipientAcc('');
    setTransferRecipientName('');
    setTransferNote('');
    setTransferPin('');
    setSelectedReceipt(newTx);
    showToast(
      lang === 'am'
        ? `የ ${amountNum.toLocaleString()} ብር ዝውውር በተሳካ ሁኔታ ተፈጽሟል! ማረጋገጫ ቁጥር: ${ref}`
        : `Transfer of ${amountNum.toLocaleString()} ETB completed successfully! Ref: ${ref}`
    );
  };

  const handleAddCustomTransaction = (e: React.FormEvent) => {
    e.preventDefault();
    const amountNum = parseFloat(newTxAmount);
    if (isNaN(amountNum) || amountNum <= 0 || !newTxTitle.trim()) return;

    const targetAccount = accounts.find((a) => a.id === newTxAccount) || accounts[0];
    const ref = `TX-REC-${Math.floor(100000 + Math.random() * 900000)}`;

    const newTx: Transaction = {
      id: `tx-${Date.now()}`,
      type: newTxType,
      title: newTxTitle,
      titleAm: newTxTitle,
      amount: amountNum,
      currency: 'ETB',
      date: new Date().toISOString().replace('T', ' ').slice(0, 16),
      category: newTxCategory,
      categoryAm: newTxCategory,
      fromAccountId: targetAccount.id,
      status: 'completed',
      referenceNo: ref,
      note: 'Direct ledger entry',
    };

    setAccounts((prev) =>
      prev.map((acc) => {
        if (acc.id !== targetAccount.id) return acc;
        if (newTxType === 'income') {
          return { ...acc, balance: acc.balance + amountNum };
        } else {
          return { ...acc, balance: Math.max(0, acc.balance - amountNum) };
        }
      })
    );

    setTransactions((prev) => [newTx, ...prev]);
    setIsAddTxModalOpen(false);
    setNewTxTitle('');
    setNewTxAmount('');
    showToast(
      lang === 'am' ? 'አዲስ የሂሳብ እንቅስቃሴ በተሳካ ሁኔታ ተመዝግቧል!' : 'Transaction recorded successfully!'
    );
  };

  const handleImportSampleStatement = () => {
    const sampleTxs: Transaction[] = [
      {
        id: `tx-imp-1`,
        type: 'income',
        title: 'Customer Direct Wire - Alsam Plaza',
        titleAm: 'የደንበኛ ቀጥታ ባንክ ገቢ - አልሳም ፕላዛ',
        amount: 85000,
        currency: 'ETB',
        date: '2026-10-08 09:14',
        category: 'Client Revenue',
        categoryAm: 'የደንበኛ ገቢ',
        fromAccountId: 'acc-1',
        recipientName: 'Alsam Trading PLC',
        status: 'completed',
        referenceNo: 'TX-DSH-990112',
      },
      {
        id: `tx-imp-2`,
        type: 'expense',
        title: 'Supplier Settlement - Hardware',
        titleAm: 'ለአቅራቢ የተከፈለ - የቢሮ እቃዎች',
        amount: 32500,
        currency: 'ETB',
        date: '2026-10-08 10:20',
        category: 'Supplies',
        categoryAm: 'ዕቃዎችና ግብይት',
        fromAccountId: 'acc-1',
        recipientName: 'Bole Tech Importers',
        status: 'completed',
        referenceNo: 'TX-DSH-448102',
      },
      {
        id: `tx-imp-3`,
        type: 'income',
        title: 'POS Terminal Daily Settlement',
        titleAm: 'የካርድ መክፈያ (POS) የቀኑ ገቢ ማጠቃለያ',
        amount: 47200,
        currency: 'ETB',
        date: '2026-10-08 11:45',
        category: 'POS Sales',
        categoryAm: 'የPOS ሽያጭ ገቢ',
        fromAccountId: 'acc-1',
        recipientName: 'Dashen POS Terminal #81',
        status: 'completed',
        referenceNo: 'TX-POS-552190',
      },
    ];

    setTransactions((prev) => [...sampleTxs, ...prev]);
    const netImp = 85000 + 47200 - 32500;
    setAccounts((prev) =>
      prev.map((a) => (a.id === 'acc-1' ? { ...a, balance: a.balance + netImp } : a))
    );

    setIsImportStatementModalOpen(false);
    showToast(
      lang === 'am'
        ? `3 አዳዲስ የቀጥታ ባንክ እንቅስቃሴዎች እና የተጣራ +${netImp.toLocaleString()} ብር ገቢ ተጭኗል!`
        : `3 live transactions imported and +${netImp.toLocaleString()} ETB credited to Dashen Bank!`
    );
  };

  return (
    <div className="min-h-screen bg-slate-950 text-slate-100 flex flex-col font-sans selection:bg-amber-500 selection:text-black">
      {/* Toast Alert */}
      {toastMessage && (
        <div className="fixed top-5 right-5 z-50 bg-emerald-600 text-white px-5 py-3 rounded-xl shadow-2xl flex items-center space-x-3 border border-emerald-400/40">
          <CheckCircle2 className="w-5 h-5 flex-shrink-0" />
          <span className="text-sm font-medium">{toastMessage}</span>
        </div>
      )}

      {/* Online & Live Status Banner with Direct Install/Download Trigger */}
      <div className="bg-emerald-950/80 border-b border-emerald-800/60 px-4 py-2.5 text-xs flex flex-wrap items-center justify-between gap-2 text-emerald-200">
        <div className="flex items-center space-x-2">
          <span className="relative flex h-2.5 w-2.5">
            <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
