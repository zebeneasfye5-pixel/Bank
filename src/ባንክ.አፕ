              <div>
                <label className="block text-slate-300 font-medium mb-1">
                  {lang === 'am' ? 'ሒሳብ ይምረጡ' : 'Select Account'}
                </label>
                <select
                  value={newTxAccount}
                  onChange={(e) => setNewTxAccount(e.target.value)}
                  className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-white focus:outline-none focus:border-amber-500"
                >
                  {accounts.map((a) => (
                    <option key={a.id} value={a.id}>
                      {lang === 'am' ? a.nameAm : a.name}
                    </option>
                  ))}
                </select>
              </div>

              <div>
                <label className="block text-slate-300 font-medium mb-1">
                  {lang === 'am' ? 'የክፍያው ርዕስ / መግለጫ' : 'Title / Description'}
                </label>
                <input
                  type="text"
                  placeholder="e.g. Daily Cash Sales or Office Supplies"
                  value={newTxTitle}
                  onChange={(e) => setNewTxTitle(e.target.value)}
                  required
                  className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-white focus:outline-none focus:border-amber-500"
                />
              </div>

              <div>
                <label className="block text-slate-300 font-medium mb-1">
                  {lang === 'am' ? 'መጠን (ብር)' : 'Amount (ETB)'}
                </label>
                <input
                  type="number"
                  min="1"
                  placeholder="e.g. 10000"
                  value={newTxAmount}
                  onChange={(e) => setNewTxAmount(e.target.value)}
                  required
                  className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-white text-sm font-bold focus:outline-none focus:border-amber-500"
                />
              </div>

              <div>
                <label className="block text-slate-300 font-medium mb-1">
                  {lang === 'am' ? 'ምድብ' : 'Category'}
                </label>
                <select
                  value={newTxCategory}
                  onChange={(e) => setNewTxCategory(e.target.value)}
                  className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-white focus:outline-none focus:border-amber-500"
                >
                  <option value="Sales / Revenue">ሽያጭና ገቢ (Revenue)</option>
                  <option value="Client Deposit">የደንበኛ ተቀማጭ (Client Deposit)</option>
                  <option value="Rent & Lease">ኪራይ (Rent)</option>
                  <option value="Utilities">መብራትና ኢንተርኔት (Utilities)</option>
                  <option value="Supplies">ቁሳቁስና ዕቃዎች (Supplies)</option>
                  <option value="Miscellaneous">ሌሎች (Miscellaneous)</option>
                </select>
              </div>

              <div className="flex items-center space-x-3 pt-3">
                <button
                  type="button"
                  onClick={() => setIsAddTxModalOpen(false)}
                  className="w-1/2 py-2.5 rounded-xl bg-slate-800 text-slate-300 font-semibold"
                >
                  {lang === 'am' ? 'ይቅር' : 'Cancel'}
                </button>
                <button
                  type="submit"
                  className="w-1/2 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold shadow-lg"
                >
                  {lang === 'am' ? 'መዝግብ' : 'Record'}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Official Transaction Receipt Modal */}
      {selectedReceipt && (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-slate-900 border border-slate-800 rounded-3xl max-w-md w-full p-6 shadow-2xl relative text-slate-100">
            <button
              onClick={() => setSelectedReceipt(null)}
              className="absolute top-5 right-5 text-slate-400 hover:text-white p-1 rounded-lg bg-slate-800/80"
            >
              <X className="w-5 h-5" />
            </button>

            <div className="text-center pb-4 border-b border-dashed border-slate-700">
              <div className="w-12 h-12 mx-auto rounded-2xl bg-amber-500/20 text-amber-400 border border-amber-500/30 flex items-center justify-center mb-2">
                <CheckCircle2 className="w-7 h-7 text-emerald-400" />
              </div>
              <h3 className="font-bold text-base text-white">
                {lang === 'am' ? 'የክፍያ ማረጋገጫ ደረሰኝ' : 'Transaction Receipt'}
              </h3>
              <p className="text-xs text-emerald-400 font-semibold tracking-wider uppercase mt-0.5">
                {lang === 'am' ? 'በተሳካ ሁኔታ ተጠናቋል' : 'Transaction Completed'}
              </p>
              <p className="text-2xl font-black text-white mt-2">
                {selectedReceipt.amount.toLocaleString()} {selectedReceipt.currency}
              </p>
            </div>

            <div className="py-4 space-y-2.5 text-xs">
              <div className="flex justify-between">
                <span className="text-slate-400">{lang === 'am' ? 'የማጣቀሻ ቁጥር' : 'Reference No'}:</span>
                <span className="font-mono font-bold text-amber-400">{selectedReceipt.referenceNo}</span>
              </div>
              <div className="flex justify-between">
                <span className="text-slate-400">{lang === 'am' ? 'ቀን እና ሰዓት' : 'Date & Time'}:</span>
                <span className="text-slate-200">{selectedReceipt.date}</span>
              </div>
              <div className="flex justify-between">
                <span className="text-slate-400">{lang === 'am' ? 'ዓይነት' : 'Type'}:</span>
                <span className="text-slate-200 uppercase font-semibold">
                  {lang === 'am' ? selectedReceipt.categoryAm : selectedReceipt.category}
                </span>
              </div>
              {selectedReceipt.recipientName && (
                <div className="flex justify-between">
                  <span className="text-slate-400">{lang === 'am' ? 'ተቀባይ' : 'Recipient'}:</span>
                  <span className="text-slate-200 font-medium">{selectedReceipt.recipientName}</span>
                </div>
              )}
              {selectedReceipt.recipientAccount && (
                <div className="flex justify-between">
                  <span className="text-slate-400">{lang === 'am' ? 'የተቀባይ ሂሳብ' : 'Recipient Account'}:</span>
                  <span className="font-mono text-slate-300">{selectedReceipt.recipientAccount}</span>
                </div>
              )}
              {selectedReceipt.recipientBank && (
                <div className="flex justify-between">
                  <span className="text-slate-400">{lang === 'am' ? 'ተቀባይ ባንክ' : 'Bank'}:</span>
                  <span className="text-slate-200">{selectedReceipt.recipientBank}</span>
                </div>
              )}
              {selectedReceipt.note && (
                <div className="flex justify-between">
                  <span className="text-slate-400">{lang === 'am' ? 'ማስታወሻ' : 'Note'}:</span>
                  <span className="text-slate-300 text-right">{selectedReceipt.note}</span>
                </div>
              )}
            </div>

            <div className="pt-4 border-t border-dashed border-slate-700 flex items-center space-x-2">
              <button
                onClick={() => {
                  navigator.clipboard.writeText(
                    `BirrFlow Receipt: ${selectedReceipt.referenceNo}\nAmount: ${selectedReceipt.amount} ETB\nDate: ${selectedReceipt.date}\nStatus: SUCCESS`
                  );
                  showToast(lang === 'am' ? 'ደረሰኙ ኮፒ ተደርጓል!' : 'Receipt copied to clipboard!');
                }}
                className="flex-1 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-200 flex items-center justify-center space-x-1.5 transition"
              >
                <Share2 className="w-3.5 h-3.5" />
                <span>{lang === 'am' ? 'ኮፒ አድርግ' : 'Share'}</span>
              </button>
              <button
                onClick={() => window.print()}
                className="flex-1 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold flex items-center justify-center space-x-1.5 transition shadow-lg shadow-amber-500/20"
              >
                <Printer className="w-3.5 h-3.5" />
                <span>{lang === 'am' ? 'አትም (Print)' : 'Print'}</span>
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Footer */}
      <footer className="bg-slate-900 border-t border-slate-800 py-6 text-center text-xs text-slate-500">
        <div className="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-3">
          <div className="flex items-center space-x-2">
            <Building2 className="w-4 h-4 text-amber-500" />
            <span className="text-slate-300 font-semibold">BirrFlow Live Dashboard</span>
            <span>—</span>
            <span>{lang === 'am' ? 'የዳሽን ባንክ እና የንግድ ፋይናንስ ቀጥታ መቆጣጠሪያ' : 'Live Financial Flow & Cash Retention Engine'}</span>
          </div>
          <div className="flex items-center space-x-3">
            <button
              onClick={handleInstallClick}
              className="text-emerald-400 hover:underline font-medium flex items-center space-x-1"
            >
              <Download className="w-3.5 h-3.5" />
              <span>{lang === 'am' ? 'በነፃ ጫን (Install App)' : 'Install Free'}</span>
            </button>
            <span>•</span>
            <span>© 2026 BirrFlow</span>
          </div>
        </div>
      </footer>
    </div>
  );
}
